# Database
DATABASE_URL="postgresql://user:password@localhost:5432/marketplace"

# ── Connection pool tuning ────────────────────────────────────────────────────
#
# The indexer maintains TWO separate Prisma connection pools:
#
#   READ  pool  (db.ts)         — used by all API route handlers.
#   WRITE pool  (prisma-write.ts) — used by the poller, parser, and backfill.
#
# Keeping the pools separate prevents burst writes from exhausting connections
# needed by the API, and vice-versa.
#
# Total connections claimed from PostgreSQL = DB_CONNECTION_LIMIT + DB_WRITE_CONNECTION_LIMIT.
# Ensure POSTGRES_MAX_CONNECTIONS (docker-compose default: 50) ≥ the total.
#
# DB_CONNECTION_LIMIT — Max connections in the READ (API) pool. (default: 10)
#   Increase when you see "pool timeout" errors under high API load.
#   Rule of thumb: 10 per API worker process; cap at ~40 for a single instance.
DB_CONNECTION_LIMIT=10

# DB_WRITE_CONNECTION_LIMIT — Max connections in the WRITE (poller/backfill) pool. (default: 3)
#   3 connections are sufficient for the write path in normal operation.
#   Increase to 5–10 only if you run parallel backfill workers on the same host.
DB_WRITE_CONNECTION_LIMIT=3

# DB_POOL_TIMEOUT — Seconds to wait for a free connection before throwing. (default: 30)
#   A low value (e.g. 10) causes fast failures under pool exhaustion; a higher
#   value queues more requests before surfacing an error.  30 s is a safe default.
DB_POOL_TIMEOUT=30

# DB_STATEMENT_TIMEOUT — Max execution time per query in milliseconds. (default: 30000)
#   Recommended: 30000 (30 s) for typical queries; reduce to 10000 for strict SLA.
DB_STATEMENT_TIMEOUT=30000

# DB_IDLE_TIMEOUT — Connection idle timeout in milliseconds. (default: 30000)
DB_IDLE_TIMEOUT=30000

# DB_ACQUIRE_TIMEOUT — Max time to wait for a pool connection in ms. (default: 10000)
#   Aliased to pool_timeout in Prisma DSN.  Kept for backward compatibility.
DB_ACQUIRE_TIMEOUT=10000

# DB_HEALTH_INTERVAL_MS — How often the health probe runs in ms. (default: 30000)
#   The probe executes SELECT 1 and logs a warning if it takes > DB_HEALTH_WARN_THRESHOLD_MS.
DB_HEALTH_INTERVAL_MS=30000

# DB_HEALTH_WARN_THRESHOLD_MS — Probe latency that triggers a warning. (default: 1000)
#   Latency above 1 s is a reliable early signal of pool exhaustion.
DB_HEALTH_WARN_THRESHOLD_MS=1000

MARKETPLACE_CONTRACT_ID=
LAUNCHPAD_CONTRACT_ID=

# Dynamic multi-contract tracking (replaces MARKETPLACE_CONTRACT_ID / LAUNCHPAD_CONTRACT_ID)
# Set TRACKED_CONTRACTS as a JSON array to track multiple contracts simultaneously.
# Each entry: { "id": "<contract address>", "type": "marketplace"|"launchpad", "label": "<name>", "startLedger": 0 }
# If set, TRACKED_CONTRACTS takes precedence over the legacy single-contract variables.
# Example:
# TRACKED_CONTRACTS='[{"id":"C...mainnet","type":"marketplace","label":"mainnet","startLedger":1000000},{"id":"C...testnet","type":"marketplace","label":"testnet","startLedger":0}]'
TRACKED_CONTRACTS=

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Stellar Network
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_NETWORK="testnet"
# Network passphrase — overrides the default derived from STELLAR_NETWORK.
# Testnet default: "Test SDF Network ; September 2015"
# Mainnet:         "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE=
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"

# API
PORT=4000

# SHUTDOWN_TIMEOUT_MS — Seconds to wait for in-flight HTTP requests to drain
#   before forcefully closing the server during graceful shutdown. (default: 30000)
#   Set lower (e.g. 5000) in development; keep at 30000+ in production.
SHUTDOWN_TIMEOUT_MS=30000

# CONFIRMATION_DEPTH (#286) — Number of ledgers that must accumulate on top of
# an event's ledger before it is promoted from "provisional" to "confirmed".
# Stellar achieves practical finality in 1-2 ledgers; the default of 10 gives
# a conservative safety margin without meaningfully delaying UI visibility.
# Set to 0 to mark all events confirmed immediately (useful for testnet).
CONFIRMATION_DEPTH=10

# Redis cache TTL in seconds for API responses (default: 30)
REDIS_CACHE_TTL_SECONDS=30

# CORS — comma-separated list of allowed frontend origins (production only).
# In development (NODE_ENV != production) all origins are permitted.
# Example: CORS_ORIGIN=https://app.ELCARE-HUB.xyz,https://staging.ELCARE-HUB.xyz
CORS_ORIGIN=

# ── Keeper subsystem ──────────────────────────────────────────────────────────
#
# The keeper calls permissionless maintenance entry-points on the marketplace
# contract (expire_listing, finalize_auction, reclaim_offer) automatically.
#
# KEEPER_ENABLED        — Set to "true" to activate the keeper loop.
#                         Default: false (keeper does not run).
KEEPER_ENABLED=false

# KEEPER_SECRET         — Stellar secret key (starts with "S") for the keeper
#                         account.  The account must hold enough XLM to cover
#                         transaction fees.  Required when KEEPER_ENABLED=true.
#                         Generate with: stellar keys generate keeper-account
KEEPER_SECRET=

# KEEPER_DRY_RUN        — Set to "false" to enable real on-chain submissions.
#                         Default: true (simulate and log only; no broadcasts).
KEEPER_DRY_RUN=true

# KEEPER_INTERVAL_MS    — How often (ms) the keeper runs a sweep cycle.
#                         Default: 60000 (1 minute).
KEEPER_INTERVAL_MS=60000

# KEEPER_MAX_ACTIONS_PER_CYCLE
#                       — Maximum maintenance actions per cycle.
#                         Default: 20.
KEEPER_MAX_ACTIONS_PER_CYCLE=20

# KEEPER_MAX_FEE_STROOPS
#                       — Hard cap on fee per transaction (in stroops).
#                         1 XLM = 10_000_000 stroops.  Default: 1_000_000 (~0.1 XLM).
KEEPER_MAX_FEE_STROOPS=1000000

# KEEPER_DAILY_FEE_BUDGET_STROOPS
#                       — Total fees the keeper may spend per calendar day.
#                         Keeper halts and alerts when exhausted.
#                         Default: 10_000_000 (~1 XLM / day).
KEEPER_DAILY_FEE_BUDGET_STROOPS=10000000

# KEEPER_FEE_BUMP_MULTIPLIER
#                       — Fee multiplier applied on each escalation step.
#                         Default: 1.5 (+50% per bump).
KEEPER_FEE_BUMP_MULTIPLIER=1.5

# KEEPER_FEE_BUMP_MAX_RETRIES
#                       — Maximum number of fee-bump attempts before marking
#                         an action as Failed.  Default: 3.
KEEPER_FEE_BUMP_MAX_RETRIES=3

# KEEPER_SUBMIT_TIMEOUT_MS
#                       — Seconds the tx builder uses as the Soroban timeout.
#                         Default: 30000 (30 s).
KEEPER_SUBMIT_TIMEOUT_MS=30000

# KEEPER_POLL_TIMEOUT_MS
#                       — Total time to poll getTransaction before triggering
#                         a fee-bump.  Default: 60000 (60 s).
KEEPER_POLL_TIMEOUT_MS=60000

# KEEPER_POLL_INTERVAL_MS
#                       — Interval between getTransaction polls.
#                         Default: 2000 (2 s).
KEEPER_POLL_INTERVAL_MS=2000

# KEEPER_DISCOVERY_LIMIT
#                       — Max Active listings / Pending offers to check per
#                         discovery sweep (bounds RPC calls).  Default: 200.
KEEPER_DISCOVERY_LIMIT=200

# ── Gap-repair worker ─────────────────────────────────────────────────────────
#
# The gap-repair worker finds Open LedgerGap rows (created whenever the poller
# skips a window or detects a reorg) and runs BackfillJob scans against the
# archival RPC to fill them in.
#
# GAP_REPAIR_ENABLED      — Set to "true" to start the worker inside the main
#                           indexer process.  Default: false.
GAP_REPAIR_ENABLED=false

# ARCHIVAL_STELLAR_RPC_URL — A full-history RPC endpoint used by backfill and
#                            gap-repair.  Defaults to STELLAR_RPC_URL if unset.
ARCHIVAL_STELLAR_RPC_URL=

# GAP_REPAIR_INTERVAL_MS  — How often the worker scans for Open gaps (ms).
#                           Default: 120000 (2 minutes).
GAP_REPAIR_INTERVAL_MS=120000

# GAP_REPAIR_MAX_RETRIES  — How many times to retry a failing gap repair before
#                           marking it Failed.  Default: 3.
GAP_REPAIR_MAX_RETRIES=3

# GAP_REPAIR_BATCH_SIZE   — Ledgers per batch during gap repair.
#                           Defaults to BACKFILL_BATCH_SIZE (5000).
GAP_REPAIR_BATCH_SIZE=5000

# BACKFILL_BATCH_SIZE     — Ledgers per batch for all backfill jobs.  Default: 5000.
BACKFILL_BATCH_SIZE=5000

# BACKFILL_CONCURRENCY    — Number of ledger batches to fetch/write in parallel.
#                           Default: 5.  Max: 20.
#                           Higher values reduce wall-clock time for large backfills
#                           but increase DB and RPC load.  Keep ≤ DB_WRITE_CONNECTION_LIMIT
#                           to avoid connection exhaustion on the write pool.
BACKFILL_CONCURRENCY=5

# ── Query cost model ──────────────────────────────────────────────────────────
#
# The query cost model assigns a numeric cost to each query parameter combination
# and rejects queries that exceed the per-tier budget. This protects the read pool
# from expensive ad-hoc queries without blocking legitimate paginated access.
#
# Cost weights — additive per query dimension:
# QUERY_COST_LARGE_PAGE       — limit > 100    (default: 20)
# QUERY_COST_MEDIUM_PAGE      — limit 51–100   (default: 10)
# QUERY_COST_DEEP_OFFSET      — offset > 1000  (default: 15)
# QUERY_COST_FTS_SEARCH       — full-text GIN  (default: 25)
# QUERY_COST_ILIKE_SEARCH     — ILIKE fallback (default: 10)
# QUERY_COST_PRICE_RANGE      — price filter   (default: 5)
# QUERY_COST_MULTI_FILTER     — 3+ filters     (default: 5)
# QUERY_COST_SORT             — non-default    (default: 5)
# QUERY_COST_TIME_RANGE       — from/to params (default: 10)
# QUERY_COST_JOIN             — implicit JOIN  (default: 15)
# QUERY_COST_STATS_AGGREGATION— GROUP BY/SUM   (default: 20)
# QUERY_COST_CROSS_ENTITY     — per extra type (default: 15)
#
# Per-tier budgets:
# QUERY_COST_BUDGET_PUBLIC    — anonymous / wallet-authed callers (default: 60)
# QUERY_COST_BUDGET_OPERATOR  — operator-token callers (default: 200)
#
# Operator diagnostics: GET /admin/query-cost returns current weights and budgets.
QUERY_COST_BUDGET_PUBLIC=60
QUERY_COST_BUDGET_OPERATOR=200
